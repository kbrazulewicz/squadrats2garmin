<<<version>>>
1

<<<info>>>
summary: Squadrats style
version: 1.0

description {
The default style used for Squadrats.
}

<<<options>>>
# Map Visibility: auto
# 16 -
# 17 - 20km
# 18 - 12km
# 19 -
# 20 - 3km
# 22 - 800m
# 23 - 300m
# level 4: squadrats (visited:low resolution)
# level 3: squadrats (visited:medium resolution)
# level 2: squadrats (visited:medium resolution + grid:low resolution)
# level 1: squadrats (visited:high resolution + grid:low resolution)
# level 0: squadrats (visited:high resolution + grid:high resolution), squadratinhos (visited + grid)

levels: 0:24, 1:23, 2:22, 3:20, 4:17, 5:15

<<<lines>>>
# squadrats grid
name=grid & zoom=14 [0x11410 level 2-3 continue]
name=grid & zoom=14 [0x11411 level 1]

# visited squadrats border
name=squadrats { delete name; } [0x10401 level 3 continue]
name=squadrats { delete name; } [0x10402 level 3]

# squadratinho grid
name=grid & zoom=17 [0x11400 level 1]

# visited squadratinhos border
name=squadratinhos { delete name; } [0x10411 level 1 continue]
name=squadratinhos { delete name; } [0x10412 level 1]

# ubersquadrat & ubersquadratinho
name=ubersquadrat [0x10E09 level 5]
name=ubersquadratinho [0x10E0A level 1]


<<<points>>>
# Level-17 centroid '+' marker: visible only when zoomed in close so it never clutters wider views
grid_center=17 { delete name; } [0x11501 resolution 23]


<<<polygons>>>
# Intentionally empty

<<<relations>>>
# propagate 'name' tag to all members of multipolygon relations
type=multipolygon & (name=squadrats | name=squadratinhos | name=ubersquadrat | name=ubersquadratinho) {
    apply {
        set name='${name}';
    }
}